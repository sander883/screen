# Helius API key - daftar gratis di https://helius.dev
# Free tier: 100K request/hari - cukup untuk screening
HELIUS_API_KEY=your_helius_api_key_here

# Telegram Bot Token - buat via @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID - bisa personal chat atau group
# Cara dapat: kirim pesan ke bot, lalu buka
# https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Screening Mode ──────────────────────────────────────────────
# fresh    → token baru launch, mcap $3K-$150K, pair age <30m (AGRESIF)
# standard → sweet spot, mcap $20K-$500K, pair age <2h
# safe     → established token, mcap $50K-$1M, pair age <24h
SCREENING_MODE=fresh

# ── Override Threshold (opsional) ───────────────────────────────
# Bisa override angka spesifik tanpa ganti mode:
# MIN_MARKET_CAP_USD=5000
# MAX_MARKET_CAP_USD=100000
# MIN_LIQUIDITY_SOL=5
# MIN_HOLDER_COUNT=15
# MAX_PAIR_AGE_SECONDS=900
