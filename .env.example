# Helius API key - daftar gratis di https://helius.dev
# Free tier: 100K request/hari - cukup untuk screening
HELIUS_API_KEY=your_helius_api_key_here

# Telegram Bot Token - buat via @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID - bisa personal chat atau group
# Cara dapat: kirim pesan ke bot, lalu buka
# https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
